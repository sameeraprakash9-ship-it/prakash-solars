PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/solar_trading
JWT_SECRET=change_this_secret
JWT_EXPIRES=7d
# Comma-separated exact frontend origins. Add the deployed Vercel URL in Render.
CLIENT_URL=http://localhost:5173
# SMTP credentials are required to send password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_private_password
ADMIN_NAME=Grid Admin
# Optional local demo seed password (at least 12 characters).
DEMO_PASSWORD=
